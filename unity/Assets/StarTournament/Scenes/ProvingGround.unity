        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F; \u0442\u0440\u0435\u043A
        \u043F\u043E\u043A\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
      Unit: percent
      Minimum: 0
      Maximum: 100
      Step: 5
      DefaultValue: 70
    - Path: audio.effectsDefaultPercent
      Group: audio
      Label: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E"
