      Minimum: 2
      Maximum: 10
      Step: 0.1
      DefaultValue: 4
    - Path: fixture.stairRise
      Group: arena-foundation
      Label: Stair rise
      Description: Height per generated stair.
      Unit: meters
      Minimum: 0.05
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.25
    - Path: fixture.stairTread
      Group: arena-foundation
      Label: Stair tread
