      Minimum: 0
      Maximum: 1
      Step: 0.05
      DefaultValue: 0.8
    - Path: audio.damageBonusPickupGain
      Group: audio
      Label: "\u0422\u0440\u0435\u0432\u043E\u0433\u0430 \u043F\u043E\u0434\u0431\u043E\u0440\u0430
        \u0431\u043E\u043D\u0443\u0441\u0430 \u0443\u0440\u043E\u043D\u0430"
      Description: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u043E\u0431\u0449\u0435\u0433\u043E
        \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0430
        \u0431\u0435\u0437 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044F
        \u0441\u043E\u0431\u0440\u0430\u0432\u0448\u0435\u0433\u043E."
      Unit: ratio
      Minimum: 0
      Maximum: 1
      Step: 0.05
      DefaultValue: 1
    - Path: audio.maxVoices
      Group: audio
      Label: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430"
      Description: "\u041F\u0440\u0435\u0434\u0435\u043B \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
        \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432
        \u0432 \u043E\u0431\u0449\u0435\u043C \u0432\u044B\u0445\u043E\u0434\u0435
        split-screen; \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
        \u043B\u0443\u0447\u0438 \u0438 \u043C\u0435\u043D\u044E \u0438\u043C\u0435\u044E\u0442
        \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435
        \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438."
