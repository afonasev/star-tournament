  TrooperBodyPrefab: {fileID: 3136562236329590072, guid: 345aa6c8664344616ae0a3980a9f6ac6, type: 3}
  TrooperArmsPrefab: {fileID: 206464274784029693, guid: 54b95b770862640cc94dc11340d68177, type: 3}
  TrooperClips:
  - {fileID: 7400000, guid: fc6e3cae87e53499e8f2ae83f8fc3127, type: 2}
  - {fileID: 7400000, guid: 5cb3b159d01f84925ae4d3431763eb27, type: 2}
  - {fileID: 7400000, guid: cc65308ec4ceb4f3eb1fe83010418cd9, type: 2}
  - {fileID: 7400000, guid: 7333d29abd5284ee891a770c1caa52ae, type: 2}
  - {fileID: 7400000, guid: 38e3446d9feb74199b6bb2d583161bf6, type: 2}
  - {fileID: 7400000, guid: 4f19644510c5f43a79228c1ecd7f096a, type: 2}
  - {fileID: 7400000, guid: 9f27516f7c4934364811b75d489893b2, type: 2}
  TrooperProfile:
    id: unity-trooper-presentation-v1
    version: 2
    descriptors:
    - Path: animation.walkThreshold
      Group: trooper-animation
      Label: "\u041F\u043E\u0440\u043E\u0433 \u0448\u0430\u0433\u0430"
      Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
        \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u043B\u044F walk."
      Unit: meters-per-second
      Minimum: 0.01
      Maximum: 3
      Step: 0.01
      DefaultValue: 0.1
    - Path: animation.runThreshold
      Group: trooper-animation
      Label: "\u041F\u043E\u0440\u043E\u0433 \u0431\u0435\u0433\u0430"
      Description: "\u0424\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
        walk \u043D\u0430 run."
      Unit: meters-per-second
      Minimum: 3
      Maximum: 15
      Step: 0.1
      DefaultValue: 6
    - Path: animation.blendSeconds
      Group: trooper-animation
      Label: "\u041F\u0435\u0440\u0435\u0445\u043E\u0434 \u043F\u043E\u0437\u044B"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0441\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u044F
        \u0432\u0435\u0441\u043E\u0432 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0445
        \u043A\u043B\u0438\u043F\u043E\u0432."
      Unit: seconds
      Minimum: 0
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.12
    - Path: animation.aimHoldSeconds
      Group: trooper-animation
      Label: "\u0411\u043E\u0435\u0432\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u0430"
      Description: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
        aim \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u043E\u0433\u043E
        \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430."
      Unit: seconds
      Minimum: 0.4
      Maximum: 5
      Step: 0.1
      DefaultValue: 1.6
    - Path: view.x
      Group: trooper-view
      Label: "\u0420\u0443\u043A\u0438 \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u0438"
      Description: "\u0421\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0432\u0441\u0435\u0439
        \u043C\u043E\u0434\u0435\u043B\u0438 \u0440\u0443\u043A \u0438 \u043E\u0440\u0443\u0436\u0438\u044F
        \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043A\u0430\u043C\u0435\u0440\u044B."
      Unit: meters
      Minimum: -0.5
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.2
    - Path: view.y
      Group: trooper-view
      Label: "\u0420\u0443\u043A\u0438 \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438"
      Description: "\u0421\u043C\u0435\u0449\u0435\u043D\u0438\u0435 feet-origin
        \u043C\u043E\u0434\u0435\u043B\u0438 \u0440\u0443\u043A \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043A\u0430\u043C\u0435\u0440\u044B."
      Unit: meters
      Minimum: -2
      Maximum: -0.5
      Step: 0.01
      DefaultValue: -1.46
    - Path: view.z
      Group: trooper-view
      Label: "\u0420\u0443\u043A\u0438 \u043F\u043E \u0433\u043B\u0443\u0431\u0438\u043D\u0435"
      Description: "\u0421\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438
        \u0440\u0443\u043A \u0432\u043F\u0435\u0440\u0451\u0434 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043A\u0430\u043C\u0435\u0440\u044B."
      Unit: meters
      Minimum: -0.5
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.05
    - Path: grip.supportRoll
      Group: trooper-grip
      Label: "\u0420\u0430\u0437\u0432\u043E\u0440\u043E\u0442 \u043E\u043F\u043E\u0440\u043D\u043E\u0439
        \u043A\u0438\u0441\u0442\u0438"
      Description: "\u0414\u043E\u0432\u043E\u0440\u043E\u0442 \u0442\u044B\u043B\u044C\u043D\u043E\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043B\u0435\u0432\u043E\u0439
        \u043A\u0438\u0441\u0442\u0438 \u043A \u0432\u043D\u0435\u0448\u043D\u0435\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0446\u0435\u0432\u044C\u044F
        \u043F\u043E\u0441\u043B\u0435 \u043A\u043B\u0438\u043F\u0430."
      Unit: degrees
      Minimum: -90
      Maximum: 90
      Step: 1
      DefaultValue: 55
    - Path: grip.supportFingerCurl
      Group: trooper-grip
      Label: "\u0425\u0432\u0430\u0442 \u043E\u043F\u043E\u0440\u043D\u044B\u0445
        \u043F\u0430\u043B\u044C\u0446\u0435\u0432"
      Description: "\u0414\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u044B\u0439
        \u0441\u0433\u0438\u0431 \u043F\u0430\u043B\u044C\u0446\u0435\u0432 \u0432\u043E\u043A\u0440\u0443\u0433
        \u0446\u0435\u0432\u044C\u044F; \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442
        \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443."
      Unit: degrees
      Minimum: -30
      Maximum: 45
      Step: 1
      DefaultValue: 12
    - Path: grip.supportThumbCurl
      Group: trooper-grip
      Label: "\u041E\u043F\u043E\u0440\u043D\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
        \u043F\u0430\u043B\u0435\u0446"
      Description: "\u0414\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u044B\u0439
        \u0441\u0433\u0438\u0431 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
        \u043F\u0430\u043B\u044C\u0446\u0430 \u0432 \u043E\u043F\u043E\u0440\u043D\u043E\u043C
        \u0445\u0432\u0430\u0442\u0435."
      Unit: degrees
      Minimum: -30
      Maximum: 45
      Step: 1
      DefaultValue: 5
    - Path: view.fillIntensity
      Group: trooper-view
      Label: "\u041F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
      Description: "\u041C\u044F\u0433\u043A\u0438\u0439 \u0441\u0432\u0435\u0442
        \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0440\u0443\u043A\u0438
        \u0441\u0432\u043E\u0435\u0433\u043E viewport \u0434\u043B\u044F \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0441\u0442\u0438
        \u0442\u0451\u043C\u043D\u043E\u0439 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438."
      Unit: intensity
      Minimum: 0
      Maximum: 4
      Step: 0.05
      DefaultValue: 0.05
    - Path: view.fillRange
      Group: trooper-view
      Label: "\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u043A\u0438"
      Description: "\u0420\u0430\u0434\u0438\u0443\u0441 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0441\u0432\u0435\u0442\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F;
        \u043C\u0438\u0440 \u0438\u0441\u043A\u043B\u044E\u0447\u0451\u043D \u043C\u0430\u0441\u043A\u043E\u0439
        \u0441\u043B\u043E\u044F."
      Unit: meters
      Minimum: 0.5
      Maximum: 3
      Step: 0.1
      DefaultValue: 2
    values:
    - Path: animation.walkThreshold
      Value: 0.1
    - Path: animation.runThreshold
      Value: 6
    - Path: animation.blendSeconds
      Value: 0.12
    - Path: animation.aimHoldSeconds
      Value: 1.6
    - Path: view.x
      Value: 0.2
    - Path: view.y
      Value: -1.46
    - Path: view.z
      Value: 0.05
    - Path: grip.supportRoll
      Value: 55
    - Path: grip.supportFingerCurl
      Value: 12
    - Path: grip.supportThumbCurl
      Value: 5
    - Path: view.fillIntensity
      Value: 0.05
    - Path: view.fillRange
      Value: 2
  Profile:
    id: unity-proving-ground-v1
    version: 2
    descriptors:
    - Path: simulation.fixedTickHz
      Group: simulation
      Label: Fixed tick frequency
      Description: Frequency of native movement and gameplay ticks, independent of
        rendered FPS.
      Unit: Hz
      Minimum: 30
      Maximum: 120
      Step: 1
      DefaultValue: 50
    - Path: player.capsule.radius
      Group: player-capsule
      Label: Capsule radius
      Description: Collision radius of a participant capsule.
      Unit: meters
      Minimum: 0.2
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.55
    - Path: player.capsule.height
      Group: player-capsule
      Label: Capsule height
      Description: Full CharacterController capsule height.
      Unit: meters
      Minimum: 1
      Maximum: 4
      Step: 0.01
      DefaultValue: 1.8
    - Path: player.capsule.skinWidth
      Group: player-capsule
      Label: Controller skin width
      Description: Minimum collision separation used by CharacterController.
      Unit: meters
      Minimum: 0.001
      Maximum: 0.1
      Step: 0.001
      DefaultValue: 0.01
    - Path: player.movement.maximumGroundSpeed
      Group: player-movement
      Label: Maximum ground speed
      Description: Horizontal speed cap on ground and in air.
      Unit: meters-per-second
      Minimum: 1
      Maximum: 30
      Step: 0.1
      DefaultValue: 9
    - Path: player.movement.groundAcceleration
      Group: player-movement
      Label: Ground acceleration
      Description: Horizontal acceleration while grounded.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 200
      Step: 0.1
      DefaultValue: 45
    - Path: player.movement.groundDeceleration
      Group: player-movement
      Label: Ground deceleration
      Description: Horizontal deceleration without directional input.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 200
      Step: 0.1
      DefaultValue: 32
    - Path: player.movement.airAcceleration
      Group: player-movement
      Label: Air acceleration
      Description: Horizontal steering acceleration while airborne.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 100
      Step: 0.1
      DefaultValue: 12
    - Path: player.movement.gravity
      Group: player-movement
      Label: Gravity
      Description: Positive downward acceleration.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 100
      Step: 0.1
      DefaultValue: 24
    - Path: player.movement.jumpSpeed
      Group: player-movement
      Label: Jump speed
      Description: Vertical speed applied to a grounded jump.
      Unit: meters-per-second
      Minimum: 0.1
      Maximum: 30
      Step: 0.1
      DefaultValue: 8.5
    - Path: player.movement.stepOffset
      Group: player-movement
      Label: Step offset
      Description: Highest stair step traversable by CharacterController without
        jumping.
      Unit: meters
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.45
    - Path: player.movement.slopeLimitDegrees
      Group: player-movement
      Label: Slope limit
      Description: Maximum climbable CharacterController slope angle.
      Unit: degrees
      Minimum: 0
      Maximum: 89
      Step: 1
      DefaultValue: 45
    - Path: input.mouseDegreesPerPixel
      Group: input
      Label: Mouse degrees per pixel
      Description: Look rotation created by one mouse pixel.
      Unit: degrees-per-pixel
      Minimum: 0.01
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.12
    - Path: input.gamepadDegreesPerSecond
      Group: input
      Label: Gamepad degrees per second
      Description: Maximum analog-stick look rotation rate.
      Unit: degrees-per-second
      Minimum: 1
      Maximum: 720
      Step: 1
      DefaultValue: 180
    - Path: input.deadzone
      Group: input
      Label: Input deadzone
      Description: Radial deadzone applied before creating LocalAction.
      Unit: ratio
      Minimum: 0
      Maximum: 0.95
      Step: 0.01
      DefaultValue: 0.15
    - Path: camera.eyeHeight
      Group: camera
      Label: Eye height
      Description: Camera height above the participant feet anchor.
      Unit: meters
      Minimum: 0.1
      Maximum: 2.5
      Step: 0.01
      DefaultValue: 1.55
    - Path: camera.maximumPitchDegrees
      Group: camera
      Label: Maximum pitch
      Description: Symmetric vertical aim clamp.
      Unit: degrees
      Minimum: 30
      Maximum: 89
      Step: 1
      DefaultValue: 85
    - Path: camera.fieldOfViewDegrees
      Group: camera
      Label: Field of view
      Description: Vertical camera field of view.
      Unit: degrees
      Minimum: 50
      Maximum: 130
      Step: 1
      DefaultValue: 90
    - Path: camera.nearClipPlane
      Group: camera
      Label: Near clip plane
      Description: Nearest camera rendering distance.
      Unit: meters
      Minimum: 0.01
      Maximum: 10
      Step: 0.01
      DefaultValue: 0.05
    - Path: camera.farClipPlane
      Group: camera
      Label: Far clip plane
      Description: Farthest camera rendering distance.
      Unit: meters
      Minimum: 10
      Maximum: 1000
      Step: 1
      DefaultValue: 250
    - Path: camera.stairSmoothingSeconds
      Group: camera
      Label: Stair smoothing
      Description: Camera-only vertical smoothing duration for stair traversal.
      Unit: seconds
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.12
    - Path: camera.stairMaximumOffsetMeters
      Group: camera
      Label: Maximum stair smoothing offset
      Description: Maximum camera-only vertical smoothing offset.
      Unit: meters
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.2
    - Path: ui.fontSize
      Group: ui
      Label: Body font size
      Description: Base font size for four-seat HUD labels.
      Unit: points
      Minimum: 12
      Maximum: 48
      Step: 1
      DefaultValue: 20
    - Path: ui.headingFontSize
      Group: ui
      Label: Heading font size
      Description: Heading font size for setup and pause UI.
      Unit: points
      Minimum: 16
      Maximum: 64
      Step: 1
      DefaultValue: 28
    - Path: ui.indicatorVisualHeight
      Group: ui
      Label: HUD indicator height
      Description: Visible height shared by health, armor and ammo icons and their
        numbers.
      Unit: points
      Minimum: 20
      Maximum: 64
      Step: 1
      DefaultValue: 32
    - Path: ui.nameFontSize
      Group: ui
      Label: Player name size
      Description: Font size of the bottom-centered per-seat name.
      Unit: points
      Minimum: 10
      Maximum: 32
      Step: 1
      DefaultValue: 16
    - Path: ui.killNoticeFontSize
      Group: ui
      Label: Kill notice size
      Description: Font size of the per-seat kill and death notice.
      Unit: points
      Minimum: 12
      Maximum: 48
      Step: 1
      DefaultValue: 26
    - Path: ui.killNoticeSeconds
      Group: ui
      Label: Kill notice lifetime
      Description: Simulation-time visibility after a direct kill.
      Unit: seconds
      Minimum: 0.5
      Maximum: 8
      Step: 0.1
      DefaultValue: 2.5
    - Path: ui.killNoticeBottom
      Group: ui
      Label: Kill notice bottom
      Description: Bottom of the notice as a viewport-height fraction.
      Unit: ratio
      Minimum: 0.1
      Maximum: 0.45
      Step: 0.01
      DefaultValue: 0.27
    - Path: ui.killNoticeTop
      Group: ui
      Label: Kill notice top
      Description: Top of the notice as a viewport-height fraction.
      Unit: ratio
      Minimum: 0.35
      Maximum: 0.6
      Step: 0.01
      DefaultValue: 0.44
    - Path: ui.centerTimerSeamGap
      Group: ui
      Label: Center timer seam gap
      Description: Distance below the horizontal viewport seam for the shared timer
        in the three-seat layout.
      Unit: points
      Minimum: 0
      Maximum: 64
      Step: 1
      DefaultValue: 16
    - Path: ui.viewportDividerWidth
      Group: ui
      Label: Viewport divider width
      Description: Thickness of opaque black lines between local viewports.
      Unit: points
      Minimum: 2
      Maximum: 24
      Step: 1
      DefaultValue: 6
    - Path: presentation.lightIntensity
      Group: presentation
      Label: Fixture light intensity
      Description: Presentation-only fixture light intensity.
      Unit: intensity
      Minimum: 0.1
      Maximum: 4
      Step: 0.1
      DefaultValue: 1.1
    - Path: presentation.armorPickupHoverHeight
      Group: armor-pickup
      Label: "\u0412\u044B\u0441\u043E\u0442\u0430 \u043F\u0430\u0440\u0435\u043D\u0438\u044F
        \u0449\u0438\u0442\u0430"
      Description: "Presentation-only \u0432\u044B\u0441\u043E\u0442\u0430 \u0431\u043E\u043D\u0443\u0441\u0430
        \u043D\u0430\u0434 \u043E\u043F\u043E\u0440\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E."
      Unit: meters
      Minimum: 0
      Maximum: 3
      Step: 0.01
      DefaultValue: 0.7
    - Path: presentation.armorPickupRotationDegreesPerSecond
      Group: armor-pickup
      Label: "\u0412\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0449\u0438\u0442\u0430"
      Description: "Presentation-only \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0431\u043E\u043D\u0443\u0441\u0430."
      Unit: degrees-per-second
      Minimum: 0
      Maximum: 720
      Step: 1
      DefaultValue: 80
    - Path: presentation.speedPickupHoverHeight
      Group: speed-pickup
      Label: "\u0412\u044B\u0441\u043E\u0442\u0430 \u043F\u0430\u0440\u0435\u043D\u0438\u044F
        \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
      Description: "Presentation-only \u0432\u044B\u0441\u043E\u0442\u0430 speed
        bonus \u043D\u0430\u0434 \u043E\u043F\u043E\u0440\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E."
      Unit: meters
      Minimum: 0
      Maximum: 3
      Step: 0.01
      DefaultValue: 0.7
    - Path: presentation.speedPickupRotationDegreesPerSecond
      Group: speed-pickup
      Label: "\u0412\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
      Description: "Presentation-only \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F speed bonus."
      Unit: degrees-per-second
      Minimum: 0
      Maximum: 720
      Step: 1
      DefaultValue: 110
    - Path: presentation.viewWeaponX
      Group: presentation
      Label: View weapon X
      Description: First-person weapon mount horizontal translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.36
    - Path: presentation.viewWeaponY
      Group: presentation
      Label: View weapon Y
      Description: First-person weapon mount vertical translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: -0.34
    - Path: presentation.viewWeaponZ
      Group: presentation
      Label: View weapon Z
      Description: First-person weapon mount forward translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.68
    - Path: presentation.worldWeaponMountY
      Group: presentation
      Label: World weapon mount Y
      Description: World weapon mount translation above the robot semantic hand mount.
      Unit: meters
      Minimum: -1
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.22
    - Path: presentation.vector.muzzleSeconds
      Group: vector-shot-feedback
      Label: "\u0412\u0441\u043F\u044B\u0448\u043A\u0430 Vector"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0434\u0432\u043E\u0439\u043D\u043E\u0439
        \u0434\u0443\u043B\u044C\u043D\u043E\u0439 \u0432\u0441\u043F\u044B\u0448\u043A\u0438."
      Unit: seconds
      Minimum: 0.01
      Maximum: 0.2
      Step: 0.01
      DefaultValue: 0.07
    - Path: presentation.vector.muzzleSize
      Group: vector-shot-feedback
      Label: "\u0420\u0430\u0437\u043C\u0435\u0440 \u0432\u0441\u043F\u044B\u0448\u043A\u0438
        Vector"
      Description: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439
        \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u044F
        \u043F\u0440\u0438\u0446\u0435\u043B\u0430."
      Unit: meters
      Minimum: 0.01
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.09
    - Path: presentation.vector.smokeSeconds
      Group: vector-shot-feedback
      Label: "\u0414\u044B\u043C Vector"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E
        \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u043D\u0438\u044F \u0434\u0443\u043B\u044C\u043D\u043E\u0433\u043E
        \u0434\u044B\u043C\u0430."
      Unit: seconds
      Minimum: 0.1
      Maximum: 1.5
      Step: 0.05
      DefaultValue: 0.4
    - Path: presentation.vector.smokeSize
      Group: vector-shot-feedback
      Label: "\u0420\u0430\u0437\u043C\u0435\u0440 \u0434\u044B\u043C\u0430 Vector"
      Description: "\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u043E\u0431\u043B\u0430\u0447\u043A\u0430 \u0434\u044B\u043C\u0430."
      Unit: meters
      Minimum: 0.01
      Maximum: 0.4
      Step: 0.01
      DefaultValue: 0.09
    - Path: presentation.vector.smokeSpeed
      Group: vector-shot-feedback
      Label: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0434\u044B\u043C\u0430
        Vector"
      Description: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
        \u0434\u044B\u043C\u0430 \u043E\u0442 \u0441\u0442\u0432\u043E\u043B\u0430."
      Unit: meters-per-second
      Minimum: 0.01
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.24
    - Path: presentation.vector.sparkCount
      Group: vector-shot-feedback
      Label: "\u0418\u0441\u043A\u0440\u044B Vector"
      Description: "\u0427\u0438\u0441\u043B\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
        \u0438\u0441\u043A\u0440 \u0438\u0437 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
        \u0441\u0442\u0432\u043E\u043B\u0430."
      Unit: count
      Minimum: 0
      Maximum: 16
      Step: 1
      DefaultValue: 5
    - Path: presentation.vector.sparkSpeed
      Group: vector-shot-feedback
      Label: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0441\u043A\u0440
        Vector"
      Description: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0437\u0430\u0442\u0443\u0445\u0430\u044E\u0449\u0438\u0445
        \u0438\u0441\u043A\u0440."
      Unit: meters-per-second
      Minimum: 0.1
      Maximum: 10
      Step: 0.1
      DefaultValue: 2
    - Path: presentation.vector.sparkSize
      Group: vector-shot-feedback
      Label: "\u0420\u0430\u0437\u043C\u0435\u0440 \u0438\u0441\u043A\u0440 Vector"
      Description: "\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043C\u0435\u043B\u043A\u0438\u0445
        \u0438\u0441\u043A\u0440."
      Unit: meters
      Minimum: 0.001
      Maximum: 0.04
      Step: 0.001
      DefaultValue: 0.008
    - Path: presentation.vector.sparkSeconds
      Group: vector-shot-feedback
      Label: "\u0412\u0440\u0435\u043C\u044F \u0438\u0441\u043A\u0440 Vector"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0436\u0438\u0437\u043D\u0438
        \u043C\u0435\u043B\u043A\u0438\u0445 \u0438\u0441\u043A\u0440."
      Unit: seconds
      Minimum: 0.01
      Maximum: 0.4
      Step: 0.01
      DefaultValue: 0.12
    - Path: presentation.vector.sparkConeDegrees
      Group: vector-shot-feedback
      Label: "\u041A\u043E\u043D\u0443\u0441 \u0438\u0441\u043A\u0440 Vector"
      Description: "\u0423\u0433\u043E\u043B \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0440\u0430\u0437\u043B\u0451\u0442\u0430, \u043D\u0435 gameplay spread."
      Unit: degrees
      Minimum: 0
      Maximum: 60
      Step: 1
      DefaultValue: 18
    - Path: presentation.shotFlightSeconds
      Group: shot-feedback
      Label: "\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0434\u0440\u043E\u0431\u0438"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E
        \u043F\u043E\u043B\u0451\u0442\u0430 \u0434\u0440\u043E\u0431\u0438\u043D\u044B
        \u0434\u043E authoritative \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
        \u0442\u043E\u0447\u043A\u0438."
      Unit: seconds
      Minimum: 0.02
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.12
    - Path: presentation.shotTracerWidth
      Group: shot-feedback
      Label: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0434\u0440\u043E\u0431\u0438"
      Description: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0433\u043E
        presentation-only \u043F\u0443\u0442\u0438 \u0434\u0440\u043E\u0431\u0438\u043D\u044B."
      Unit: meters
      Minimum: 0.005
      Maximum: 0.2
      Step: 0.005
      DefaultValue: 0.01
    - Path: presentation.shotMuzzleClearance
      Group: shot-feedback
      Label: "\u0417\u0430\u0437\u043E\u0440 \u043E\u0442 muzzle"
      Description: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 presentation-only
        \u0437\u0430\u0437\u043E\u0440, \u043E\u0442\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0439
        \u0434\u0440\u043E\u0431\u044C \u043E\u0442 muzzle burst first-person \u043E\u0440\u0443\u0436\u0438\u044F."
      Unit: meters
      Minimum: 0
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.1
    - Path: presentation.shotImpactSeconds
      Group: shot-feedback
      Label: "\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        impact"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E
        contact impact \u0431\u0435\u0437 persistent decal."
      Unit: seconds
      Minimum: 0.02
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.12
    - Path: presentation.shotImpactSize
      Group: shot-feedback
      Label: "\u0420\u0430\u0437\u043C\u0435\u0440 impact"
      Description: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043A\u0440\u0430\u0442\u043A\u043E\u0433\u043E
        material-aware contact impact."
      Unit: meters
      Minimum: 0.01
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.16
    - Path: presentation.shotMaxEffects
      Group: shot-feedback
      Label: "\u041B\u0438\u043C\u0438\u0442 \u0434\u0440\u043E\u0431\u0438"
      Description: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
        \u0436\u0438\u0432\u044B\u0445 visual \u0434\u0440\u043E\u0431\u0438\u043D
        \u043E\u0434\u043D\u043E\u0433\u043E presentation owner."
      Unit: count
      Minimum: 8
      Maximum: 256
      Step: 1
      DefaultValue: 96
    - Path: navigation.sampleDistance
      Group: navigation
      Label: Navigation sample distance
      Description: Maximum endpoint projection distance for fixture navigation queries;
        not bake spacing.
      Unit: meters
      Minimum: 0.1
      Maximum: 10
      Step: 0.1
      DefaultValue: 2
    - Path: weapon.probeRange
      Group: weapon
      Label: Weapon probe range
      Description: Fixture hitscan diagnostic range.
      Unit: meters
      Minimum: 1
      Maximum: 100
      Step: 1
      DefaultValue: 35
    - Path: weapon.probeCooldown
      Group: weapon
      Label: Weapon probe cooldown
      Description: Minimum interval between fixture firing probes.
      Unit: seconds
      Minimum: 0.1
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.7
    - Path: world.minimumSupportHeight
      Group: world-query
      Label: Lowest support probe
      Description: Lower world bound for corpse support queries; does not author
        geometry.
      Unit: meters
      Minimum: -100
      Maximum: 0
      Step: 1
      DefaultValue: -10
    - Path: world.maximumTransitionSegment
      Group: world-query
      Label: Declared route segment bound
      Description: Maximum distance between declared traversal samples.
      Unit: meters
      Minimum: 1
      Maximum: 100
      Step: 0.5
      DefaultValue: 20
