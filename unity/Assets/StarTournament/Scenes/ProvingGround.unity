      Minimum: 0
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.35
    - Path: input.gamepadReturnDegreesPerSecond
      Group: input
      Label: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043D\u0438\u044F"
      Description: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u043B\u0430\u0432\u043D\u043E\u0433\u043E
        \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u043D\u0430\u043A\u043B\u043E\u043D\u0430
        \u043A \u0443\u043A\u043B\u043E\u043D\u0443 \u043F\u043E\u043B\u0430."
      Unit: "\xB0/\u0441"
      Minimum: 1
      Maximum: 180
      Step: 1
      DefaultValue: 45
    - Path: input.gamepadReturnSmoothingSeconds
      Group: input
      Label: "\u041F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u044C \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043D\u0438\u044F"
