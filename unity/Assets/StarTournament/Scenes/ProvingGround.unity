      DefaultValue: 80
    - Path: audio.damageBonusSpawnGain
      Group: audio
      Label: "\u0421\u0438\u0433\u043D\u0430\u043B \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F
        \u0431\u043E\u043D\u0443\u0441\u0430 \u0443\u0440\u043E\u043D\u0430"
      Description: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u043E\u0431\u0449\u0435\u0433\u043E
        \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E
        \u043E\u0442 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
        \u0434\u043E \u0431\u043E\u043D\u0443\u0441\u0430."
