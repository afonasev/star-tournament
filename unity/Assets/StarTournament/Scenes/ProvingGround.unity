  LifeProfile:
    id: unity-combat-state-v1
    version: 1
    descriptors:
    - Path: combat.maximumHealth
      Group: combat
      Label: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
      Description: "\u041F\u043E\u043B\u043D\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
        \u043A\u0430\u0436\u0434\u043E\u0439 \u043D\u043E\u0432\u043E\u0439 \u0436\u0438\u0437\u043D\u0438."
      Unit: health
      Minimum: 1
      Maximum: 1000
      Step: 1
      DefaultValue: 100
    - Path: armor.maximum
      Group: armor-pickup
      Label: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u0431\u0440\u043E\u043D\u0438"
      Description: "\u0412\u0435\u0440\u0445\u043D\u044F\u044F \u0433\u0440\u0430\u043D\u0438\u0446\u0430
        \u0431\u0440\u043E\u043D\u0438 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430."
      Unit: armor
      Minimum: 1
      Maximum: 1000
      Step: 1
      DefaultValue: 100
    - Path: armor.pickupAmount
      Group: armor-pickup
      Label: "\u0411\u0440\u043E\u043D\u044F \u043E\u0442 \u0431\u043E\u043D\u0443\u0441\u0430"
      Description: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0431\u0440\u043E\u043D\u0438 \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E
        \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
        \u0431\u043E\u043D\u0443\u0441\u0430."
      Unit: armor
      Minimum: 1
      Maximum: 1000
      Step: 1
      DefaultValue: 50
    - Path: armor.respawnSeconds
      Group: armor-pickup
      Label: "\u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u0431\u043E\u043D\u0443\u0441\u0430"
      Description: "Simulation-\u0432\u0440\u0435\u043C\u044F \u0434\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
        \u0449\u0438\u0442\u0430 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u0431\u043E\u0440\u0430."
      Unit: seconds
      Minimum: 1
      Maximum: 120
      Step: 1
      DefaultValue: 30
    - Path: armor.pickupRadius
      Group: armor-pickup
      Label: "\u0420\u0430\u0434\u0438\u0443\u0441 \u043F\u043E\u0434\u0431\u043E\u0440\u0430"
      Description: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
        \u0440\u0430\u0434\u0438\u0443\u0441 authoritative \u043F\u043E\u0434\u0431\u043E\u0440\u0430
        \u0449\u0438\u0442\u0430."
      Unit: meters
      Minimum: 0.1
      Maximum: 5
      Step: 0.05
      DefaultValue: 1.2
    - Path: speed.multiplier
      Group: speed-pickup
      Label: "\u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
      Description: "\u041C\u043D\u043E\u0436\u0438\u0442\u0435\u043B\u044C horizontal
        maximum speed \u0432\u043E \u0432\u0440\u0435\u043C\u044F speed bonus."
      Unit: ratio
      Minimum: 1.05
      Maximum: 3
      Step: 0.05
      DefaultValue: 1.5
    - Path: speed.durationSeconds
      Group: speed-pickup
      Label: "\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
      Description: "Simulation-\u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
        speed bonus."
      Unit: seconds
      Minimum: 0.1
      Maximum: 60
      Step: 0.1
      DefaultValue: 10
    - Path: speed.initialDelaySeconds
      Group: speed-pickup
      Label: "\u041F\u0435\u0440\u0432\u043E\u0435 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435"
      Description: "Simulation-\u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0441\u0442\u0430\u0440\u0442\u0430
        \u043C\u0430\u0442\u0447\u0430 \u0434\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E
        speed bonus."
      Unit: seconds
      Minimum: 0
      Maximum: 60
      Step: 0.1
      DefaultValue: 10
    - Path: speed.respawnSeconds
      Group: speed-pickup
      Label: "\u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
      Description: "Simulation-\u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
        \u043F\u043E\u0434\u0431\u043E\u0440\u0430 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
        speed bonus."
      Unit: seconds
      Minimum: 0.1
      Maximum: 120
      Step: 0.1
      DefaultValue: 20
    - Path: speed.pickupRadius
      Group: speed-pickup
      Label: "\u0420\u0430\u0434\u0438\u0443\u0441 \u043F\u043E\u0434\u0431\u043E\u0440\u0430
        \u0443\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u044F"
      Description: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
        authoritative \u0440\u0430\u0434\u0438\u0443\u0441 speed bonus."
      Unit: meters
      Minimum: 0.1
      Maximum: 5
      Step: 0.05
      DefaultValue: 1.2
    - Path: combat.startingAmmo
      Group: shotgun
      Label: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u0431\u043E\u0435\u0437\u0430\u043F\u0430\u0441"
      Description: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
        \u0436\u0438\u0437\u043D\u0438."
      Unit: ammo
      Minimum: 1
      Maximum: 200
      Step: 1
      DefaultValue: 20
    - Path: combat.emptyRefillAmmo
      Group: shotgun
      Label: "\u041F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u0438
        \u043D\u0443\u043B\u0435"
      Description: "\u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439
        \u0437\u0430\u043F\u0430\u0441 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
        \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0431\u0435\u0437 \u0441\u0431\u0440\u043E\u0441\u0430
        cooldown."
      Unit: ammo
      Minimum: 1
      Maximum: 100
      Step: 1
      DefaultValue: 20
    - Path: combat.cooldownSeconds
      Group: shotgun
      Label: "\u0418\u043D\u0442\u0435\u0440\u0432\u0430\u043B \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432"
      Description: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
        simulation \u0432\u0440\u0435\u043C\u044F \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
        \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430."
      Unit: seconds
      Minimum: 0.05
      Maximum: 5
      Step: 0.05
      DefaultValue: 0.7
    - Path: combat.killcamSeconds
      Group: death
      Label: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F"
      Description: "Simulation \u0432\u0440\u0435\u043C\u044F \u0441\u043C\u0435\u0440\u0442\u0438
        \u0434\u043E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u0438
        \u043A \u0432\u044B\u0431\u043E\u0440\u0443 spawn."
      Unit: seconds
      Minimum: 0
      Maximum: 15
      Step: 0.1
      DefaultValue: 3
    values:
    - Path: combat.maximumHealth
      Value: 100
    - Path: armor.maximum
      Value: 100
    - Path: armor.pickupAmount
      Value: 50
