  RosterProfile:
    id: unity-native-roster-v1
    version: 1
    descriptors:
    - Path: spawn.initialSearchBudgetNodes
      Group: spawn
      Label: "\u0411\u044E\u0434\u0436\u0435\u0442 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0439
        \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438"
      Description: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C\u044B\u0445
        \u0443\u0437\u043B\u043E\u0432 \u043F\u043E\u0438\u0441\u043A\u0430; \u0438\u0441\u0447\u0435\u0440\u043F\u0430\u043D\u0438\u0435
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u044F\u0432\u043D\u0443\u044E
        \u043E\u0448\u0438\u0431\u043A\u0443, \u0430 \u043D\u0435 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u0443\u044E
        \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443."
      Unit: nodes
      Minimum: 100
      Maximum: 1000000
      Step: 100
      DefaultValue: 100000
    - Path: spawn.initialCandidateBudget
      Group: spawn
      Label: "\u0411\u044E\u0434\u0436\u0435\u0442 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0445
        \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u043E\u0432"
      Description: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442
        generation/physics queries \u0438 \u0440\u0430\u0437\u043C\u0435\u0440 pair
        tables; \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0434\u0430\u0451\u0442
        \u044F\u0432\u043D\u0443\u044E \u043E\u0448\u0438\u0431\u043A\u0443 \u0434\u043E
        \u043F\u043E\u0438\u0441\u043A\u0430."
      Unit: candidates
      Minimum: 32
      Maximum: 4096
      Step: 32
      DefaultValue: 1024
    values:
    - Path: spawn.initialSearchBudgetNodes
      Value: 100000
    - Path: spawn.initialCandidateBudget
      Value: 1024
