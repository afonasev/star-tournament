--- !u!114 &1529435529
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1529435528}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f45f72800493e42b3989bdfbaccc0c94, type: 3}
  m_Name:
  m_EditorClassIdentifier: StarTournament.ProvingGround::StarTournament.ProvingGround.ProvingGround
  RobotPrefab: {fileID: 8096201874892650849, guid: b9735778d36484bdda35bf8c5fdb4ffa, type: 3}
  WorldWeaponPrefab: {fileID: 2107409826236812522, guid: ef685829d5a83450f9bdf6811e30fc14, type: 3}
  ViewWeaponPrefab: {fileID: 2107409826236812522, guid: 0282f0d53c0f1428e88a06e7663127f1, type: 3}
  Profile:
    id: unity-proving-ground-v1
    version: 1
    descriptors:
    - Path: simulation.fixedTickHz
      Group: simulation
      Label: Fixed tick frequency
      Description: Frequency of native movement and gameplay ticks, independent of
        rendered FPS.
      Unit: Hz
      Minimum: 30
      Maximum: 120
      Step: 1
      DefaultValue: 50
    - Path: player.capsule.radius
      Group: player-capsule
      Label: Capsule radius
      Description: Collision radius of a participant capsule.
      Unit: meters
      Minimum: 0.2
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.55
    - Path: player.capsule.height
      Group: player-capsule
      Label: Capsule height
      Description: Full CharacterController capsule height.
      Unit: meters
      Minimum: 1
      Maximum: 4
      Step: 0.01
      DefaultValue: 1.8
    - Path: player.capsule.skinWidth
      Group: player-capsule
      Label: Controller skin width
      Description: Minimum collision separation used by CharacterController.
      Unit: meters
      Minimum: 0.001
      Maximum: 0.1
      Step: 0.001
      DefaultValue: 0.01
    - Path: player.movement.maximumGroundSpeed
      Group: player-movement
      Label: Maximum ground speed
      Description: Horizontal speed cap on ground and in air.
      Unit: meters-per-second
      Minimum: 1
      Maximum: 30
      Step: 0.1
      DefaultValue: 9
    - Path: player.movement.groundAcceleration
      Group: player-movement
      Label: Ground acceleration
      Description: Horizontal acceleration while grounded.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 200
      Step: 0.1
      DefaultValue: 45
    - Path: player.movement.groundDeceleration
      Group: player-movement
      Label: Ground deceleration
      Description: Horizontal deceleration without directional input.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 200
      Step: 0.1
      DefaultValue: 32
    - Path: player.movement.airAcceleration
      Group: player-movement
      Label: Air acceleration
      Description: Horizontal steering acceleration while airborne.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 100
      Step: 0.1
      DefaultValue: 12
    - Path: player.movement.gravity
      Group: player-movement
      Label: Gravity
      Description: Positive downward acceleration.
      Unit: meters-per-second-squared
      Minimum: 0.1
      Maximum: 100
      Step: 0.1
      DefaultValue: 24
    - Path: player.movement.jumpSpeed
      Group: player-movement
      Label: Jump speed
      Description: Vertical speed applied to a grounded jump.
      Unit: meters-per-second
      Minimum: 0.1
      Maximum: 30
      Step: 0.1
      DefaultValue: 8.5
    - Path: player.movement.stepOffset
      Group: player-movement
      Label: Step offset
      Description: Highest stair step traversable by CharacterController without
        jumping.
      Unit: meters
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.45
    - Path: player.movement.slopeLimitDegrees
      Group: player-movement
      Label: Slope limit
      Description: Maximum climbable CharacterController slope angle.
      Unit: degrees
      Minimum: 0
      Maximum: 89
      Step: 1
      DefaultValue: 45
    - Path: input.mouseDegreesPerPixel
      Group: input
      Label: Mouse degrees per pixel
      Description: Look rotation created by one mouse pixel.
      Unit: degrees-per-pixel
      Minimum: 0.01
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.12
    - Path: input.gamepadDegreesPerSecond
      Group: input
      Label: Gamepad degrees per second
      Description: Maximum analog-stick look rotation rate.
      Unit: degrees-per-second
      Minimum: 1
      Maximum: 720
      Step: 1
      DefaultValue: 180
    - Path: input.deadzone
      Group: input
      Label: Input deadzone
      Description: Radial deadzone applied before creating LocalAction.
      Unit: ratio
      Minimum: 0
      Maximum: 0.95
      Step: 0.01
      DefaultValue: 0.15
    - Path: camera.eyeHeight
      Group: camera
      Label: Eye height
      Description: Camera height above the participant feet anchor.
      Unit: meters
      Minimum: 0.1
      Maximum: 2.5
      Step: 0.01
      DefaultValue: 1.55
    - Path: camera.maximumPitchDegrees
      Group: camera
      Label: Maximum pitch
      Description: Symmetric vertical aim clamp.
      Unit: degrees
      Minimum: 30
      Maximum: 89
      Step: 1
      DefaultValue: 85
    - Path: camera.fieldOfViewDegrees
      Group: camera
      Label: Field of view
      Description: Vertical camera field of view.
      Unit: degrees
      Minimum: 50
      Maximum: 130
      Step: 1
      DefaultValue: 90
    - Path: camera.nearClipPlane
      Group: camera
      Label: Near clip plane
      Description: Nearest camera rendering distance.
      Unit: meters
      Minimum: 0.01
      Maximum: 10
      Step: 0.01
      DefaultValue: 0.05
    - Path: camera.farClipPlane
      Group: camera
      Label: Far clip plane
      Description: Farthest camera rendering distance.
      Unit: meters
      Minimum: 10
      Maximum: 1000
      Step: 1
      DefaultValue: 250
    - Path: camera.stairSmoothingSeconds
      Group: camera
      Label: Stair smoothing
      Description: Camera-only vertical smoothing duration for stair traversal.
      Unit: seconds
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.12
    - Path: camera.stairMaximumOffsetMeters
      Group: camera
      Label: Maximum stair smoothing offset
      Description: Maximum camera-only vertical smoothing offset.
      Unit: meters
      Minimum: 0
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.2
    - Path: ui.fontSize
      Group: ui
      Label: Body font size
      Description: Base font size for four-seat HUD labels.
      Unit: points
      Minimum: 12
      Maximum: 48
      Step: 1
      DefaultValue: 20
    - Path: ui.headingFontSize
      Group: ui
      Label: Heading font size
      Description: Heading font size for setup and pause UI.
      Unit: points
      Minimum: 16
      Maximum: 64
      Step: 1
      DefaultValue: 28
    - Path: presentation.lightIntensity
      Group: presentation
      Label: Fixture light intensity
      Description: Presentation-only fixture light intensity.
      Unit: intensity
      Minimum: 0.1
      Maximum: 4
      Step: 0.1
      DefaultValue: 1.1
    - Path: presentation.viewWeaponX
      Group: presentation
      Label: View weapon X
      Description: First-person weapon mount horizontal translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.36
    - Path: presentation.viewWeaponY
      Group: presentation
      Label: View weapon Y
      Description: First-person weapon mount vertical translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: -0.34
    - Path: presentation.viewWeaponZ
      Group: presentation
      Label: View weapon Z
      Description: First-person weapon mount forward translation from camera origin.
      Unit: meters
      Minimum: -2
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.68
    - Path: presentation.worldWeaponMountY
      Group: presentation
      Label: World weapon mount Y
      Description: World weapon mount translation above the robot semantic hand mount.
      Unit: meters
      Minimum: -1
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.22
    - Path: navigation.sampleDistance
      Group: navigation
      Label: Navigation sample distance
      Description: AI Navigation sampling spacing for the proving-ground bake.
      Unit: meters
      Minimum: 0.1
      Maximum: 10
      Step: 0.1
      DefaultValue: 2
    - Path: fixture.width
      Group: fixture
      Label: Fixture width
      Description: Overall fixed proving-ground arena width.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.depth
      Group: fixture
      Label: Fixture depth
      Description: Overall fixed proving-ground arena depth.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.wallThickness
      Group: fixture
      Label: Wall thickness
      Description: Physical fixture wall thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.wallHeight
      Group: fixture
      Label: Wall height
      Description: Physical fixture wall height.
      Unit: meters
      Minimum: 1.5
      Maximum: 8
      Step: 0.1
      DefaultValue: 3
    - Path: fixture.floorThickness
      Group: fixture
      Label: Floor thickness
      Description: Physical floor and upper slab thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.floorHeight
      Group: fixture
      Label: Lower floor height
      Description: World height of the lower walkable floor.
      Unit: meters
      Minimum: -5
      Maximum: 5
      Step: 0.1
      DefaultValue: 0
    - Path: fixture.upperFloorHeight
      Group: fixture
      Label: Upper floor height
      Description: World height of the upper walkable floor.
      Unit: meters
      Minimum: 2
      Maximum: 10
      Step: 0.1
      DefaultValue: 4
    - Path: fixture.stairRise
      Group: fixture
      Label: Stair rise
      Description: Physical rise of one fixture stair.
      Unit: meters
      Minimum: 0.05
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.25
    - Path: fixture.stairTread
      Group: fixture
      Label: Stair tread
      Description: Physical depth of one fixture stair.
      Unit: meters
      Minimum: 0.1
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.75
    - Path: fixture.rampLength
      Group: fixture
      Label: Ramp length
      Description: Horizontal run of the fixture ramp.
      Unit: meters
      Minimum: 3
      Maximum: 20
      Step: 0.5
      DefaultValue: 12
    - Path: fixture.rampWidth
      Group: fixture
      Label: Ramp width
      Description: Clear width of the fixture ramp.
      Unit: meters
      Minimum: 1.2
      Maximum: 8
      Step: 0.1
      DefaultValue: 4
    - Path: fixture.headroomHeight
      Group: fixture
      Label: Headroom height
      Description: Actual lower-route clearance under the fixture upper slab.
      Unit: meters
      Minimum: 1
      Maximum: 4
      Step: 0.05
      DefaultValue: 2.1
    - Path: weapon.probeRange
      Group: weapon
      Label: Weapon probe range
      Description: Fixture hitscan diagnostic range.
      Unit: meters
      Minimum: 1
      Maximum: 100
      Step: 1
      DefaultValue: 35
    - Path: weapon.probeCooldown
      Group: weapon
      Label: Weapon probe cooldown
      Description: Minimum interval between fixture firing probes.
      Unit: seconds
      Minimum: 0.1
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.7
    values:
    - Path: simulation.fixedTickHz
      Value: 50
    - Path: player.capsule.radius
      Value: 0.55
    - Path: player.capsule.height
      Value: 1.8
    - Path: player.capsule.skinWidth
      Value: 0.01
    - Path: player.movement.maximumGroundSpeed
      Value: 9
    - Path: player.movement.groundAcceleration
      Value: 45
    - Path: player.movement.groundDeceleration
      Value: 32
    - Path: player.movement.airAcceleration
      Value: 12
    - Path: player.movement.gravity
      Value: 24
    - Path: player.movement.jumpSpeed
      Value: 8.5
    - Path: player.movement.stepOffset
      Value: 0.45
    - Path: player.movement.slopeLimitDegrees
      Value: 45
    - Path: input.mouseDegreesPerPixel
      Value: 0.12
    - Path: input.gamepadDegreesPerSecond
      Value: 180
    - Path: input.deadzone
      Value: 0.15
    - Path: camera.eyeHeight
      Value: 1.55
    - Path: camera.maximumPitchDegrees
      Value: 85
    - Path: camera.fieldOfViewDegrees
      Value: 90
    - Path: camera.nearClipPlane
      Value: 0.05
    - Path: camera.farClipPlane
      Value: 250
    - Path: camera.stairSmoothingSeconds
      Value: 0.12
    - Path: camera.stairMaximumOffsetMeters
      Value: 0.2
    - Path: ui.fontSize
      Value: 20
    - Path: ui.headingFontSize
      Value: 28
    - Path: presentation.lightIntensity
      Value: 1.1
    - Path: presentation.viewWeaponX
      Value: 0.36
    - Path: presentation.viewWeaponY
      Value: -0.34
    - Path: presentation.viewWeaponZ
      Value: 0.68
    - Path: presentation.worldWeaponMountY
      Value: 0.22
    - Path: navigation.sampleDistance
      Value: 2
    - Path: fixture.width
      Value: 32
    - Path: fixture.depth
      Value: 32
    - Path: fixture.wallThickness
      Value: 0.3
    - Path: fixture.wallHeight
      Value: 3
    - Path: fixture.floorThickness
      Value: 0.3
    - Path: fixture.floorHeight
      Value: 0
    - Path: fixture.upperFloorHeight
