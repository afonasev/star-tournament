  ArenaProfile:
    id: unity-arena-families-v1
    version: 1
    descriptors:
    - Path: arena.family
      Group: arena-family
      Label: Spatial family
      Description: 'Explicit family ordinal: 0 wide hall, 1 gallery, 2 balconies,
        3 stacked combat, 4 basement.'
      Unit: count
      Minimum: 0
      Maximum: 4
      Step: 1
      DefaultValue: 0
    - Path: fixture.width
      Group: arena-foundation
      Label: Arena width
      Description: Width shared by the ARENA-2 family catalog.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.depth
      Group: arena-foundation
      Label: Arena depth
      Description: Depth shared by the ARENA-2 family catalog.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.wallThickness
      Group: arena-foundation
      Label: Wall thickness
      Description: Physical wall thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.wallHeight
      Group: arena-foundation
      Label: Wall height
      Description: Height above each support.
      Unit: meters
      Minimum: 1.5
      Maximum: 8
      Step: 0.1
      DefaultValue: 3
    - Path: fixture.floorThickness
      Group: arena-foundation
      Label: Floor thickness
      Description: Physical floor thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.floorHeight
      Group: arena-foundation
      Label: Lower floor height
      Description: Lower support world height.
      Unit: meters
      Minimum: -5
      Maximum: 5
      Step: 0.1
      DefaultValue: 0
    - Path: fixture.upperFloorHeight
      Group: arena-foundation
      Label: Upper floor height
