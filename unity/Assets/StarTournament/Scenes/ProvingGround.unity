  LunarPresentation:
    id: lunar-laboratory-presentation-v1
    version: 4
    descriptors:
    - Path: lunar.navigationClearance
      Group: lunar-presentation
      Label: "\u0417\u0430\u043F\u0430\u0441 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
        \u043E\u0442 \u0441\u0442\u0435\u043D"
      Description: "\u041B\u0443\u043D\u043D\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F:
        \u0417\u0430\u043F\u0430\u0441 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
        \u043E\u0442 \u0441\u0442\u0435\u043D; \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435
        \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u044B."
      Unit: m
      Minimum: 0.05
      Maximum: 0.4
      Step: 0.01
      DefaultValue: 0.15
    - Path: lunar.fill
      Group: lunar-presentation
      Label: "\u0420\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442"
      Description: "\u041B\u0443\u043D\u043D\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F:
        \u0420\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442;
        \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u043D\u0435
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u044B."
      Unit: ratio
      Minimum: 0.05
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.17
    - Path: lunar.sun
      Group: lunar-presentation
      Label: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442"
      Description: "\u041B\u0443\u043D\u043D\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F:
        \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442;
        \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u043D\u0435
        \u043C\u0435\u043D\u044F\u0435\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u044B."
      Unit: intensity
      Minimum: 0
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.3
    - Path: lunar.lamp
      Group: lunar-presentation
      Label: "\u0421\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0438"
      Description: "\u041B\u0443\u043D\u043D\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F:
