      Maximum: 1
      Step: 0.01
      DefaultValue: 0.28
    - Path: presentation.shotTracerWidth
      Group: shot-feedback
      Label: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0434\u0440\u043E\u0431\u0438"
      Description: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0447\u0438\u0442\u0430\u0435\u043C\u043E\u0433\u043E
        presentation-only \u043F\u0443\u0442\u0438 \u0434\u0440\u043E\u0431\u0438\u043D\u044B."
      Unit: meters
      Minimum: 0.005
      Maximum: 0.2
      Step: 0.005
      DefaultValue: 0.055
    - Path: presentation.shotMuzzleClearance
      Group: shot-feedback
      Label: "\u0417\u0430\u0437\u043E\u0440 \u043E\u0442 muzzle"
      Description: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0439 presentation-only
        \u0437\u0430\u0437\u043E\u0440, \u043E\u0442\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0439
        \u0434\u0440\u043E\u0431\u044C \u043E\u0442 muzzle burst first-person \u043E\u0440\u0443\u0436\u0438\u044F."
      Unit: meters
      Minimum: 0
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.5
    - Path: presentation.shotImpactSeconds
      Group: shot-feedback
      Label: "\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        impact"
      Description: "\u0412\u0440\u0435\u043C\u044F \u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E
        contact impact \u0431\u0435\u0437 persistent decal."
      Unit: seconds
      Minimum: 0.02
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.12
    - Path: presentation.shotImpactSize
      Group: shot-feedback
      Label: "\u0420\u0430\u0437\u043C\u0435\u0440 impact"
      Description: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043A\u0440\u0430\u0442\u043A\u043E\u0433\u043E
        material-aware contact impact."
      Unit: meters
      Minimum: 0.01
      Maximum: 2
      Step: 0.01
      DefaultValue: 0.16
    - Path: presentation.shotMaxEffects
      Group: shot-feedback
      Label: "\u041B\u0438\u043C\u0438\u0442 \u0434\u0440\u043E\u0431\u0438"
      Description: "\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
        \u0436\u0438\u0432\u044B\u0445 visual \u0434\u0440\u043E\u0431\u0438\u043D
        \u043E\u0434\u043D\u043E\u0433\u043E presentation owner."
      Unit: count
      Minimum: 8
      Maximum: 256
      Step: 1
      DefaultValue: 96
    - Path: navigation.sampleDistance
      Group: navigation
      Label: Navigation sample distance
      Description: Maximum endpoint projection distance for fixture navigation queries;
        not bake spacing.
      Unit: meters
      Minimum: 0.1
      Maximum: 10
      Step: 0.1
      DefaultValue: 2
    - Path: fixture.width
      Group: fixture
      Label: Fixture width
      Description: Overall fixed proving-ground arena width.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.depth
      Group: fixture
      Label: Fixture depth
      Description: Overall fixed proving-ground arena depth.
      Unit: meters
      Minimum: 12
      Maximum: 80
      Step: 1
      DefaultValue: 32
    - Path: fixture.wallThickness
      Group: fixture
      Label: Wall thickness
      Description: Physical fixture wall thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.wallHeight
      Group: fixture
      Label: Wall height
      Description: Physical fixture wall height.
      Unit: meters
      Minimum: 1.5
      Maximum: 8
      Step: 0.1
      DefaultValue: 3
    - Path: fixture.floorThickness
      Group: fixture
      Label: Floor thickness
      Description: Physical floor and upper slab thickness.
      Unit: meters
      Minimum: 0.1
      Maximum: 2
      Step: 0.05
      DefaultValue: 0.3
    - Path: fixture.floorHeight
      Group: fixture
      Label: Lower floor height
      Description: World height of the lower walkable floor.
      Unit: meters
      Minimum: -5
      Maximum: 5
      Step: 0.1
      DefaultValue: 0
    - Path: fixture.upperFloorHeight
      Group: fixture
      Label: Upper floor height
      Description: World height of the upper walkable floor.
      Unit: meters
      Minimum: 2
      Maximum: 10
      Step: 0.1
      DefaultValue: 4
    - Path: fixture.stairRise
      Group: fixture
      Label: Stair rise
      Description: Physical rise of one fixture stair.
      Unit: meters
      Minimum: 0.05
      Maximum: 0.5
      Step: 0.01
      DefaultValue: 0.25
    - Path: fixture.stairTread
      Group: fixture
      Label: Stair tread
      Description: Physical depth of one fixture stair.
      Unit: meters
      Minimum: 0.1
      Maximum: 1
      Step: 0.01
      DefaultValue: 0.75
    - Path: fixture.rampLength
      Group: fixture
      Label: Ramp length
      Description: Horizontal run of the fixture ramp.
      Unit: meters
      Minimum: 3
      Maximum: 20
      Step: 0.5
      DefaultValue: 12
    - Path: fixture.rampWidth
      Group: fixture
      Label: Ramp width
      Description: Clear width of the fixture ramp.
      Unit: meters
      Minimum: 1.2
      Maximum: 8
      Step: 0.1
      DefaultValue: 4
    - Path: fixture.headroomHeight
      Group: fixture
      Label: Headroom height
      Description: Actual lower-route clearance under the fixture upper slab.
      Unit: meters
      Minimum: 1
      Maximum: 4
      Step: 0.05
      DefaultValue: 2.1
    - Path: weapon.probeRange
      Group: weapon
      Label: Weapon probe range
      Description: Fixture hitscan diagnostic range.
      Unit: meters
      Minimum: 1
      Maximum: 100
      Step: 1
      DefaultValue: 35
    - Path: weapon.probeCooldown
      Group: weapon
      Label: Weapon probe cooldown
      Description: Minimum interval between fixture firing probes.
      Unit: seconds
      Minimum: 0.1
      Maximum: 3
      Step: 0.05
      DefaultValue: 0.7
