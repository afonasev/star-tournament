{
  "name": "star-tournament",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ai:simulate": "node scripts/ai-runner.mjs",
    "ai:evaluate": "node scripts/ai-evaluate.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && vite build",
    "perf:browser": "npm run build && node scripts/run-browser-performance-gate.mjs",
    "measure:collision-bundle": "node scripts/measure-collision-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
