robowar.afonasev.tech {
    root * /opt/robowar
    encode zstd gzip
    @updateMetadata path_regexp updateMetadata ^/desktop/(.*/latest\.json|downloads\.json)$
    @updatePackage path_regexp updatePackage ^/desktop/.*\.(nupkg|exe|pkg|zip)$
    handle /desktop/* {
        header @updateMetadata Cache-Control "no-store"
        header @updatePackage Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
