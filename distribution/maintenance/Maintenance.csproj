<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>../branding/app-icon.ico</ApplicationIcon>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>StarTournamentMaintenance</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="System.Threading.AccessControl" Version="8.0.0" />
    <RuntimeHostConfigurationOption Include="System.StartupHookProvider.IsSupported" Value="false" />
    <Compile Include="../launcher/BrokerUpgradeState.cs" Link="BrokerUpgradeState.cs" />
    <Compile Include="../launcher/WindowsBrokerUpgradeStartup.cs" Link="WindowsBrokerUpgradeStartup.cs" />
    <Compile Include="../launcher/WindowsBrokerUpgradeAccess.cs" Link="WindowsBrokerUpgradeAccess.cs" />
    <Compile Include="../launcher/BrokerUpgradeCandidate.cs" Link="BrokerUpgradeCandidate.cs" />
    <Compile Include="../launcher/AuthenticatedSource.cs" Link="AuthenticatedSource.cs" />
    <Compile Include="../launcher/GitHubDiscovery.cs" Link="GitHubDiscovery.cs" />
    <Compile Include="../launcher/PlatformRequirements.cs" Link="PlatformRequirements.cs" />
    <Compile Include="../launcher/ReleaseCompatibility.cs" Link="ReleaseCompatibility.cs" />
    <Compile Include="../launcher/PayloadRecovery.cs" Link="PayloadRecovery.cs" />
    <Compile Include="../launcher/StartupRecovery.cs" Link="StartupRecovery.cs" />
    <Compile Include="../launcher/UpdateFeedback.cs" Link="UpdateFeedback.cs" />
    <Compile Include="../launcher/WindowsInstallation.cs" Link="WindowsInstallation.cs" />
    <Compile Include="../launcher/WindowsInstallLease.cs" Link="WindowsInstallLease.cs" />
    <None Include="../update-public.pem" Link="update-public.pem" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
